import ComposableArchitecture
import DesignSystem
import SwiftUI

public struct {{ name }}View: View {
    let store: StoreOf<{{ name }}Feature>

    public init(store: StoreOf<{{ name }}Feature>) {
        self.store = store
    }

    public var body: some View {
        Text("{{ name }}")
            .font(.sd.body)
            .sdScreen()
            .onAppear { store.send(.onAppear) }
    }
}

